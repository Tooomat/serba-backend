DOCKER=true
# =====================
# APP CONFIG
# =====================
NODE_ENV=development
APP_NAME=serba
APP_PORT=3000
APP_URL=http://localhost:3000

# =====================
# FRONTEND CONFIG
# =====================
FRONTEND_URL=http://localhost:5173

# =====================
# DATABASE
# =====================
DATABASE_URL="postgresql://postgres:1234@postgres:5432/serba?connect_timeout=30&idle_timeout=30" # docker

DB_HOST=postgres # docker
DB_USER=postgres
DB_PORT=5433
DB_PASSWORD=1234
DB_NAME=serba

# =====================
# JWT
# =====================
JWT_REFRESH_SECRET=refresh-token-secret
JWT_REFRESH_EXPIRE=7d
JWT_ACCESS_SECRET=access-token-secret
JWT_ACCESS_EXPIRE=1h

# =====================
# LOGGING
# =====================
LOG_LEVEL=debug

# =====================
# Cookies
# =====================
HTTPONLY_COOKIES=true
SECURE_COOKIES=false
SAMESITE_COOKIES=lax
PATH_REFRESH_TOKEN_COOKIES=/

# =====================
# CORS
# =====================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# =====================
# REDIS
# =====================
REDIS_HOST=redis # docker
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=0

# =====================
# CLOUDINARY 
# =====================
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxx

# =====================
# RESEND 
# =====================
RESEND_API_KEY=re_xxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# =====================
# OAUTH2.0-GOOGLE 
# =====================
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URL=/public/api/auth/google/callback

# =====================
# STATE = token sementara/sekali pakai untuk keamanan OAuth (anti-CSRF)
# =====================
JWT_OAUTH_STATE_SECRET=supersecret_oauth_state
JWT_OAUTH_STATE_EXPIRE=5m
