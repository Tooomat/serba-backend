// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum StatusUser {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
}

enum Mark {
  HOME
  OFFICE
}

enum JobSite {
  ON_SITE
  HYBRID
  REMOTE
}

enum BudgetTypeJob {
  FIXED
  HOURLY
  DAILY
  MONTHLY
  NEGOTIABLE
}

enum LevelJob {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum TypeJob {
  NON_URGENT
  URGENT
}

enum StatusJob {
  OPEN
  IN_PROGRESS
  CANCELED
  CLOSED
}

enum statusJobApplication {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model User {
  id              String     @id @default(uuid())
  username        String     @unique @db.VarChar(100)
  firstName       String     @map("first_name") @db.VarChar(50)
  lastName        String?    @map("last_name") @db.VarChar(100)
  email           String     @unique @db.VarChar(100)
  password        String     @db.VarChar(100)
  role            Role       @default(USER)
  phone           String     @db.VarChar(20)
  profilePictUrl  String?    @map("profile_pict_url") @db.VarChar(255)
  birthDate       DateTime   @map("birth_date") @db.Date
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  isPhoneVerified Boolean    @default(false) @map("is_phone_verified")
  status          StatusUser @default(PENDING_VERIFICATION)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)

  addresses       Address[]
  jobs            Job[]
  jobApplications JobApplication[]

  @@map("users")
}

model Address {
  id         String  @id @default(uuid())
  street     String  @db.Text
  country    String  @default("Indonesia")
  postalCode String  @map("postal_code") @db.VarChar(10)
  benchmark  String? @db.Text
  markAs     Mark    @map("mark_as")
  isPrimary  Boolean @default(true) @map("is_primary")
  locations  Json
  lat        Decimal @db.Decimal(10, 7)
  lng        Decimal @db.Decimal(10, 7)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  subdistrictId String            @map("subdistrict_id")
  subdistrict   MasterSubdistrict @relation(fields: [subdistrictId], references: [id])

  jobs Job[]

  @@map("addresses")
}

model MasterProvince {
  id   String @id
  name String @db.VarChar(255)
  code String @unique @db.VarChar(20)

  masterCities MasterCity[]

  @@map("master_provinces")
}

model MasterCity {
  id       String @id
  name     String @db.VarChar(255)
  code     String @unique @db.VarChar(20)
  province Json

  provinceId     String         @map("province_id")
  masterProvince MasterProvince @relation(fields: [provinceId], references: [id])

  masterDistricts MasterDistrict[]

  @@map("master_cities")
}

model MasterDistrict {
  id       String @id
  name     String @db.VarChar(255)
  code     String @unique @db.VarChar(20)
  province Json
  city     Json

  cityId     String     @map("city_id")
  masterCity MasterCity @relation(fields: [cityId], references: [id])

  masterSubdistricts MasterSubdistrict[]

  @@map("master_districts")
}

model MasterSubdistrict {
  id       String @id
  name     String @db.VarChar(255)
  code     String @unique @db.VarChar(20)
  province Json
  city     Json
  district Json

  districtId     String         @map("district_id")
  masterDistrict MasterDistrict @relation(fields: [districtId], references: [id])

  addresses Address[]

  @@map("master_subdistricts")
}

model JobCategory {
  id       String  @id
  code     String  @unique @db.VarChar(50)
  name     String  @unique @db.VarChar(100)
  image1   String?
  image2   String?
  image3   String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)

  categoriesMapping CategoriesMapping[]

  @@map("job_categories")
}

model CategoriesMapping {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobCategoryId String      @map("job_category_id")
  jobCategory   JobCategory @relation(fields: [jobCategoryId], references: [id])

  jobId String @map("job_id")
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("categories_mapping")
}

model Job {
  id String @id @default(uuid())

  title        String  @db.VarChar(255)
  introduction String? @db.Text
  description  String  @db.Text

  jobSite    JobSite        @map("job_site")
  budgetMin  Int?           @map("budget_min")
  budgetMax  Int?           @map("budget_max")
  budgetType BudgetTypeJob? @map("budget_type")

  level    LevelJob[]
  required Int

  status           StatusJob @default(OPEN)
  applicationCount Int       @default(0) @map("application_count")

  startTime DateTime? @map("start_time") @db.Time()
  endTime   DateTime? @map("end_time") @db.Time()
  startDate DateTime? @map("start_date") @db.Date()
  endDate   DateTime? @map("end_date") @db.Date()

  locations Json
  isPublic  Boolean @default(true) @map("is_public")

  type TypeJob @default(NON_URGENT)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)

  categoriesMapping CategoriesMapping[]

  jobProviderId String @map("job_provider_id")
  user          User   @relation(fields: [jobProviderId], references: [id])

  addressId String  @map("address_id")
  address   Address @relation(fields: [addressId], references: [id])

  jobApplications JobApplication[]

  @@map("jobs")
}

model JobApplication {
  id             String               @id @default(uuid())
  coverLetter    String?              @map("cover_letter") @db.Text
  proposedBudged Int?                 @map("proposed_budged")
  isAccepted     Boolean              @default(false) @map("is_accepted")
  appliedAt      DateTime             @default(now()) @map("applied_at") @db.Timestamptz(3)
  status         statusJobApplication @default(PENDING)

  workerId String
  user     User   @relation(fields: [workerId], references: [id])

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  @@map("job_applications")
}