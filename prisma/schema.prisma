// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum StatusUser {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
}

enum JobSite {
  ON_SITE
  HYBRID
  REMOTE
}

enum BudgetTypeJob {
  Fixed
  HOURLY
  NEGOTIABLE
}

enum LevelJob {
  BEGINER
  INTERMEDIATE
  EXPERT
}

enum TypeJob {
  NON_URGENT
  URGENT
}

enum StatusJob {
  OPEN
  COMPLETED
}

model User {
  id              String     @id @default(uuid())
  username        String     @unique @db.VarChar(100)
  firstName       String     @db.VarChar(50)
  lastName        String?    @db.VarChar(100)
  email           String     @unique @db.VarChar(100)
  password        String     @db.VarChar(100)
  role            Role       @default(USER)
  phone           String     @db.VarChar(20)
  profilePictUrl  String?    @db.VarChar(255)
  birthDate       DateTime   @db.Date
  isEmailVerified Boolean    @default(false)
  isPhoneVerified Boolean    @default(false)
  status          StatusUser @default(PENDING_VERIFICATION)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  emailVerifiedAt DateTime? @db.Timestamptz(3)
  phoneVerifiedAt DateTime? @db.Timestamptz(3)

  addresses Address[] // one user -> many addresses

  jobs Job[] // one user -> create many job

  @@map("users")
}

model Address {
  id         String  @id @default(uuid())
  street     String  @db.VarChar(255)
  country    String  @db.VarChar(50)
  postalCode String  @db.VarChar(10)
  locations  Json
  lat        Decimal @db.Decimal(10, 7)
  lng        Decimal @db.Decimal(10, 7)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subdistrictId String
  subdistrict   MasterSubdistrict @relation(fields: [subdistrictId], references: [id])

  jobs Job[] // one addresses -> many job

  @@map("addresses")
}

model MasterProvince {
  id   String @id
  name String @db.VarChar(255)
  code String @unique @db.VarChar(20)

  masterCity MasterCity[] // one province -> many cities

  @@map("master_provinces")
}

model MasterCity {
  id       String @id
  name     String @db.VarChar(255)
  code     String @unique @db.VarChar(20)
  province Json

  masterDistrict MasterDistrict[] // one city -> many districts

  provinceId     String
  masterProvince MasterProvince @relation(fields: [provinceId], references: [id])

  @@map("master_cities")
}

model MasterDistrict {
  id       String @id
  name     String @db.VarChar(255)
  code     String @unique @db.VarChar(20)
  province Json
  city     Json

  masterSubdistricts MasterSubdistrict[] // one district -> many subdistricts

  cityId     String
  masterCity MasterCity @relation(fields: [cityId], references: [id])

  @@map("master_districts")
}

model MasterSubdistrict {
  id       String @id 
  name     String @db.VarChar(255)
  code     String @unique @db.VarChar(20)
  province Json
  city     Json
  district Json

  addresses Address[] // one subdictricts -> many addresses

  districtId     String
  masterDistrict MasterDistrict @relation(fields: [districtId], references: [id])

  @@map("master_subdistricts")
}

model JobCategories {
  id        String    @id
  code      String    @unique @db.VarChar(50)
  name      String    @unique @db.VarChar(100)
  image1    String?
  image2    String?
  image3    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  // one job categories -> many categories Mapping
  categoriesMapping CategoriesMapping[]

  @@map("job_categories")
}

model CategoriesMapping {
  id        String    @id @default(uuid())
  createdAt DateTime  @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  jobCategoryId String
  jobCategories JobCategories @relation(fields: [jobCategoryId], references: [id])

  jobId String
  job Job @relation(fields: [jobId], references: [id])

  @@map("categories_mapping")
}

model Job {
  id                   String         @id @default(uuid())
  title                String         @db.VarChar(255)
  introduction         String?        @db.Text
  description          String         @db.Text
  qualification        String         @db.Text
  jobSite              JobSite
  budgetMin            Int?
  budgetMax            Int?
  budgetType           BudgetTypeJob? // Fixed, Hourly, Negotiable
  level                LevelJob[] // Beginner, Intermediate, Expert
  required             Int
  status               StatusJob      @default(OPEN) // Open, Completed
  applicationCount     Int            @default(0)
  dayOfWeek            String?        @db.VarChar(20) // Senin, Selasa, … , Minggu
  startTime            DateTime?      @db.Time()
  endTime              DateTime?      @db.Time()
  scheduleDate         DateTime?      @db.Date
  locations            Json
  jobCategories        Json
  isPublic             Boolean        @default(true)
  acceptedApplicant    Json?
  type                 TypeJob        @default(NON_URGENT)
  estimatedDurationDay Int?
  createdAt            DateTime       @db.Timestamptz(3)
  updatedAt            DateTime?      @updatedAt @db.Timestamptz(3)

  // one Job -> many Categories Mapping
  categoriesMapping CategoriesMapping[]

  userId String
  user User @relation(fields: [userId], references: [id])

  addressId String
  address Address @relation(fields: [addressId], references: [id])

  @@map("jobs")
}
