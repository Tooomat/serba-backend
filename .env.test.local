DOCKER=false
# =====================
# APP CONFIG
# =====================
NODE_ENV=test 
APP_NAME=serba
APP_V=1.0
APP_PORT=3001
APP_URL=http://localhost:3001

# =====================
# FRONTEND CONFIG
# =====================
FRONTEND_URL=http://localhost:5500

# Database
DATABASE_URL="postgresql://postgres:1234@localhost:5432/test" # local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=test

# =====================
# JWT
# =====================
JWT_REFRESH_SECRET=refresh-token-secret
JWT_REFRESH_EXPIRE=7d
JWT_ACCESS_SECRET=access-token-secret
JWT_ACCESS_EXPIRE=1h

# =====================
# LOGGING
# =====================
LOG_LEVEL=debug

# =====================
# Cookies
# =====================
HTTPONLY_COOKIES=true
SECURE_COOKIES=false
SAMESITE_COOKIES=lax
PATH_REFRESH_TOKEN_COOKIES=/

# =====================
# CORS
# =====================
CORS_ORIGIN=

# =====================
# REDIS
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=1

# =====================
# CLOUDINARY 
# =====================
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxx

# =====================
# RESEND 
# =====================
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=.....@gmail.com

# =====================
# OAUTH2.0-GOOGLE 
# =====================
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URL=/public/api/auth/google/callback

# =====================
# STATE = token sementara/sekali pakai untuk keamanan OAuth (anti-CSRF)
# =====================
JWT_OAUTH_STATE_SECRET=supersecret_oauth_state
JWT_OAUTH_STATE_EXPIRE=5m
